{
    "name": "mnapoli/backoffice-mcp",
    "description": "A read-only MCP server over a whitelist of Eloquent models, for the internal tools of a Laravel application",
    "keywords": ["laravel", "mcp", "eloquent", "admin"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/mcp": "^0.9",
        "spatie/laravel-query-builder": "^7.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "BackofficeMcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BackofficeMcp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BackofficeMcp\\BackofficeMcpServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
